{
  "name": "wws-no-7-insert",
  "version": "0.1.2",
  "private": true,
  "description": "WWS No. 7 insert - World of Warships battle assistant",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "sync:containers": "node scripts/sync-containers.cjs",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "uiohook-napi": "^1.5.4",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.wwsmonkey.app",
    "productName": "No. 7 insert",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.local",
        "to": ".env.local"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis", "portable"],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "No. 7 insert",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true,
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN"]
    }
  }
}
